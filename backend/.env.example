# ---------------------------------------------------------------------------
# DemoPilot backend configuration
# Copy to `.env` and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- LLM (required) --------------------------------------------------------
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_TOKENS=1200
GROQ_TEMPERATURE=0.4

# --- Database --------------------------------------------------------------
# sqlite  -> zero-setup local file (data/demopilot.db). Great for development.
# supabase-> hosted Postgres. Requires the three SUPABASE_* values below.
DB_BACKEND=sqlite
SQLITE_PATH=data/demopilot.db

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# --- Auth ------------------------------------------------------------------
# local    -> DemoPilot issues its own JWTs, passwords hashed with PBKDF2.
# supabase -> delegate sign-up/sign-in to Supabase Auth.
AUTH_BACKEND=local
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# --- Embeddings / RAG ------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=6
RAG_MIN_SCORE=0.18

# --- Storage paths (relative to backend/) ----------------------------------
DATA_DIR=data
UPLOAD_DIR=data/uploads
FAISS_DIR=data/faiss

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt,.md,.csv

# --- Server ----------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_APP_URL=http://localhost:5173

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
PUBLIC_RATE_LIMIT_PER_MINUTE=30
UPLOAD_RATE_LIMIT_PER_MINUTE=10
